{
	"schemaVersion": 1,
	"id": "autobuild",
	"version": "${version}",
	"name": "AutoBuild",
	"description": "Save builds to .abuild files and have your client rebuild them from your inventory.",
	"authors": ["Misha"],
	"license": "MIT",
	"environment": "client",
	"entrypoints": {
		"client": ["dev.autobuild.AutoBuildClient"]
	},
	"depends": {
		"fabricloader": ">=0.19.0",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
}
